{
  "manifest_version": 3,
  "name": "YT Music AdBlock (Opera GX)",
  "version": "2.0.0",
  "description": "Strips ads from YouTube Music API responses and auto-skips/hides any that slip through.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": [
    "*://music.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.googleadservices.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "YT Music AdBlock",
    "default_popup": "popup.html"
  }
}
